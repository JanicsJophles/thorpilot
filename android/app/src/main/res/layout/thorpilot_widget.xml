<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/widget_panel">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent"
        android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:contentDescription="Open Thorpilot workspace" android:focusable="true" android:clickable="true">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_thorpilot"
            android:contentDescription="" android:importantForAccessibility="no" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Thorpilot" android:textColor="#F2F6FC"
            android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#AEC0D0" android:textSize="12sp" android:maxLines="2" android:layout_marginBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/widget_chat" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:layout_marginEnd="8dp" android:background="@drawable/widget_action"
            android:text="Chat" android:textAllCaps="false" android:textColor="#6CF7D0" android:textSize="13sp"
            android:minWidth="0dp" android:padding="4dp" android:maxLines="1" />
        <Button android:id="@+id/widget_requests" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:background="@drawable/widget_action"
            android:text="Requests" android:textAllCaps="false" android:textColor="#F2F6FC" android:textSize="13sp"
            android:minWidth="0dp" android:padding="4dp" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
